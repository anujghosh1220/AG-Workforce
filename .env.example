# Database
DATABASE_URL=postgresql+psycopg://agworkforce:agworkforce@localhost:5432/agworkforce
# For local dev without Postgres you may use SQLite:
# DATABASE_URL=sqlite:///./agworkforce.db

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
ENVIRONMENT=development

# Registration policy
# Public sign-up is enabled by default outside production and disabled by
# default when ENVIRONMENT=production. Set explicitly to override.
# ALLOW_PUBLIC_REGISTRATION=true
# Optional shared secret required at registration when set.
# REGISTRATION_INVITE_CODE=
