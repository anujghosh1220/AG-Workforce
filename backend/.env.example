# ---- Core ----
DATABASE_URL=sqlite:///./agworkforce.db
# PostgreSQL example: postgresql+psycopg://user:pass@host:5432/agworkforce
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Set AGW_ALLOW_CREATE_ALL=1 only if you intentionally want create_all in prod.

# ---- Workers ----
# AGW_DISABLE_WORKER=1   # disables all background workers (tests)

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=

# ---- WhatsApp (Meta Cloud API) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=          # webhook signature verification
WHATSAPP_VERIFY_TOKEN=        # webhook subscription verify token

# ---- Google Calendar ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ---- LLM ----
# Provider-agnostic; configure whichever provider your LLM adapter supports.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---- Rate limiting ----
# REDIS_URL=redis://localhost:6379/0
# REQUIRE_REDIS_RATE_LIMIT=1   # fail closed in production without Redis
# WORKER_HEARTBEAT_SECONDS=15

# ---- WhatsApp Business Account ----
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# ---- LLM metering ----
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
